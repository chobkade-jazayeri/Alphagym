<!DOCTYPE html><html lang="fa" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>منوی بوفه | اکادمی بدنسازی مردان آلفا</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f3ee;--card:#fff;--tx:#1b1d26;--mut:#666b7a;--ac:#e8472b;--nv:#3c4a8f;--bd:#e4ded4;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1015;--card:#181b23;--tx:#f2f0eb;--mut:#a3a8b5;--ac:#ff6a45;--nv:#8e9cf0;--bd:#2a2e3a;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e1015;--card:#181b23;--tx:#f2f0eb;--mut:#a3a8b5;--ac:#ff6a45;--nv:#8e9cf0;--bd:#2a2e3a;color-scheme:dark}
*{box-sizing:border-box;margin:0}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{background:var(--bg);color:var(--tx);font-family:Vazirmatn,Tahoma,Arial,sans-serif;line-height:1.8}
.w{max-width:760px;margin:auto;padding:0 16px}
header{text-align:center;padding:36px 0 22px}
.logo{width:120px;height:auto;border-radius:18px;background:#fff;padding:6px;box-shadow:0 6px 24px #0003}
h1{font-size:1.5rem;font-weight:800;margin-top:14px}h1 span{color:var(--ac)}
.sub{color:var(--mut);font-size:.95rem}
.chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:14px}
.chips b{font-weight:600;font-size:.82rem;background:var(--card);border:1px solid var(--bd);border-radius:99px;padding:3px 12px}
h2{font-size:1.2rem;font-weight:800;margin:30px 0 12px;display:flex;align-items:center;gap:8px}
h2::before{content:"";width:6px;height:22px;background:var(--ac);border-radius:3px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:14px 16px;margin-bottom:10px;display:flex;justify-content:space-between;gap:12px;align-items:center}
.card h3{font-size:1rem;font-weight:800}.card p{color:var(--mut);font-size:.88rem}
.pr{white-space:nowrap;font-weight:800;color:var(--ac);text-align:left}.pr small{display:block;color:var(--mut);font-weight:400;font-size:.72rem}
.list{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:4px 16px}
.row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--bd)}.row:last-child{border:0}
.row span:last-child{font-weight:800;color:var(--ac);white-space:nowrap}
img.ph{width:100%;height:auto;border-radius:16px;display:block}
.g{display:grid;grid-template-columns:1fr 1fr;gap:10px}.g img{height:100%;object-fit:cover}
.note{color:var(--mut);font-size:.85rem;margin-top:8px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.tags span{font-size:.8rem;background:var(--card);border:1px solid var(--bd);border-radius:99px;padding:2px 11px}
.btns{display:grid;gap:10px;margin-top:6px}
.btn{display:block;text-align:center;text-decoration:none;font-weight:800;padding:13px;border-radius:14px;background:var(--ac);color:#fff}
.btn.o{background:transparent;color:var(--tx);border:2px solid var(--nv)}
footer{text-align:center;color:var(--mut);font-size:.85rem;padding:28px 0 36px}
.th{width:68px;height:46px;flex:none;display:block}.tap{cursor:pointer}
.card>div:not(.pr){flex:1}.row{align-items:center;gap:10px}.row>span:first-of-type{flex:1}.row .th{width:56px;height:38px}
dialog{border:0;border-radius:22px;background:var(--card);color:var(--tx);width:calc(100% - 32px);max-width:360px;padding:18px;text-align:center;margin:auto}
dialog::backdrop{background:#000b}dialog svg{width:100%;height:auto}dialog h3{margin-top:6px;font-weight:800}
dialog .x{position:absolute;top:8px;left:10px;border:0;background:none;color:var(--mut);font-size:1.8rem;line-height:1;cursor:pointer}
</style></head><body>
<header class="w"><img class="logo" src="data:image/jpeg;base64," alt="آرم آلفا جیم کلاب">
<h1>اکادمی بدنسازی مردان <span>آلفا</span></h1>
<div class="sub">Alpha Gym Club · منوی بوفه</div>
<div class="chips"><b>ویژه آقایان</b><b>هر روز ۷:۰۰ تا ۲۳:۰۰</b><b>مدیریت: حسین‌زاده</b></div></header>
<main class="w">
<h2>بشقاب‌های ویژه</h2>
<div class="card"><div><h3>بشقاب ۱</h3><p>برگر + ۱ فیله + برنج + دورچین</p></div><div class="pr">۴۱۵٬۰۰۰<small>تومان</small></div></div>
<div class="card"><div><h3>بشقاب ۲</h3><p>۲ عدد فیله + ماکارونی + سیب‌زمینی + دورچین</p></div><div class="pr">۳۹۵٬۰۰۰<small>تومان</small></div></div>
<div class="card"><div><h3>بشقاب ۳</h3><p>۲ عدد فیله + سیب‌زمینی + ۲ عدد تخم‌مرغ + دورچین</p></div><div class="pr">۳۱۰٬۰۰۰<small>تومان</small></div></div>
<h2>منوی تکی</h2>
<div class="list">
<div class="row"><span>برگر گوشت (تک) ۱۲۰ گرمی</span><span>۲۳۰٬۰۰۰ تومان</span></div>
<div class="row"><span>برگر فیله (تک) ۱۲۰ گرمی</span><span>۱۴۰٬۰۰۰ تومان</span></div>
<div class="row"><span>فیله (هر عدد)</span><span>۱۱۰٬۰۰۰ تومان</span></div>
<div class="row"><span>ماکارونی</span><span>۱۴۰٬۰۰۰ تومان</span></div>
<div class="row"><span>برنج</span><span>۹۰٬۰۰۰ تومان</span></div>
<div class="row"><span>سیب‌زمینی</span><span>۳۵٬۰۰۰ تومان</span></div>
<div class="row"><span>دورچین</span><span>۳۵٬۰۰۰ تومان</span></div>
<div class="row"><span>ذرت (تکه)</span><span>۳۰٬۰۰۰ تومان</span></div>
<div class="row"><span>تخم‌مرغ</span><span>۲۵٬۰۰۰ تومان</span></div></div>
<h2>منوی کافه</h2>
<p class="note" style="margin:0 0 6px">نوشیدنی گرم</p>
<div class="list">
<div class="row"><span>اسپرسو دبل</span><span>۱۰۰٬۰۰۰ تومان</span></div>
<div class="row"><span>اسپرسو تک</span><span>۹۰٬۰۰۰ تومان</span></div>
<div class="row"><span>کاپوچینو</span><span>۷۰٬۰۰۰ تومان</span></div>
<div class="row"><span>چای ماسالا</span><span>۸۰٬۰۰۰ تومان</span></div></div>
<p class="note" style="margin:14px 0 6px">نوشیدنی سرد و انرژی‌زا</p>
<div class="list">
<div class="row"><span>آب معدنی</span><span>۳۵٬۰۰۰ تومان</span></div>
<div class="row"><span>نوشابه زیرو قوطی</span><span>۹۵٬۰۰۰ تومان</span></div>
<div class="row"><span>نوشابه بطری زیرو</span><span>۶۵٬۰۰۰ تومان</span></div>
<div class="row"><span>نوشیدنی تخم‌شربتی</span><span>۸۵٬۰۰۰ تومان</span></div>
<div class="row"><span>ویتامین سی</span><span>۸۵٬۰۰۰ تومان</span></div>
<div class="row"><span>ویتامین سی کوچک</span><span>۶۵٬۰۰۰ تومان</span></div>
<div class="row"><span>انرژی‌زا کوچک</span><span>۱۲۰٬۰۰۰ تومان</span></div>
<div class="row"><span>انرژی‌زا بزرگ</span><span>۱۶۰٬۰۰۰ تومان</span></div>
<div class="row"><span>شیر پروتئین کاله</span><span>۲۱۰٬۰۰۰ تومان</span></div>
<div class="row"><span>جنسینگ</span><span>۱۹۰٬۰۰۰ تومان</span></div></div>
<p class="note" style="margin:14px 0 6px">اسنک و مکمل</p>
<div class="list">
<div class="row"><span>شکلات ویفر مگا</span><span>۴۰٬۰۰۰ تومان</span></div>
<div class="row"><span>شکلات ویفر استارلاو</span><span>۷۰٬۰۰۰ تومان</span></div>
<div class="row"><span>خرما</span><span>۴۰٬۰۰۰ تومان</span></div>
<div class="row"><span>موز</span><span>۱۱۰٬۰۰۰ تومان</span></div>
<div class="row"><span>میکس گردو</span><span>۸۰٬۰۰۰ تومان</span></div>
<div class="row"><span>تارس میکس بزرگ</span><span>۹۰٬۰۰۰ تومان</span></div>
<div class="row"><span>میکس پسته</span><span>۱۲۰٬۰۰۰ تومان</span></div>
<div class="row"><span>پروتئین بار</span><span>۱۸۰٬۰۰۰ تومان</span></div>
<div class="row"><span>پروتئین بار اتلتیکا</span><span>۲۳۰٬۰۰۰ تومان</span></div>
<div class="row"><span>پروتئین وی ساشه‌ای (تک‌سرو)</span><span>۲۳۰٬۰۰۰ تومان</span></div></div>
<h2>یخچال بوفه</h2>
<img class="ph" src="data:image/jpeg;base64," alt="یخچال نوشیدنی و تنقلات بوفه">
<div class="tags" style="display:none"><span>انرژی‌زا</span><span>شیر پروتئینی موز</span><span>کوکاکولا زیرو</span><span>نوشیدنی‌های میوه‌ای</span><span>ویتامین C</span><span>موز</span><span>ویفر</span><span>دسر</span><span>آب معدنی</span></div>
<p class="note" style="display:none">قیمت نوشیدنی‌ها و تنقلات را از بوفه بپرسید.</p>
<h2>فضای غذاخوری</h2>
<div class="g"><img class="ph" src="data:image/jpeg;base64," alt="فضای غذاخوری آلفا"><img class="ph" src="data:image/jpeg;base64," alt="فضای غذاخوری آلفا"></div>
<h2>ارتباط با ما</h2>
<div class="btns">
<a class="btn" href="https://maps.app.goo.gl/AAC8KV8MmX1pQED38?g_st=ic" target="_blank" rel="noopener">مسیریابی در گوگل مپ</a>
<a class="btn o" href="https://www.instagram.com/alpha_gymclub2025" target="_blank" rel="noopener">اینستاگرام @alpha_gymclub2025</a></div>
<p class="note">آدرس: شهر گلستان، کوچه دانش، پلاک ۱۳</p>
</main>
<footer class="w">اکادمی بدنسازی مردان آلفا · مدیریت حسین‌زاده</footer>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
<symbol id="i-burger" viewBox="0 0 64 64"><path d="M8 28a24 20 0 0 1 48 0z" fill="#e8a33d"/><g fill="#ffe7b0"><ellipse cx="24" cy="18" rx="2.5" ry="1.4"/><ellipse cx="34" cy="14" rx="2.5" ry="1.4"/><ellipse cx="43" cy="19" rx="2.5" ry="1.4"/></g><path d="M6 31q5 5 10 0t10 0 10 0 10 0 10 0v4H6z" fill="#5fb04a"/><rect x="6" y="35" width="52" height="9" rx="4.5" fill="#6b3b22"/><rect x="8" y="46" width="48" height="10" rx="5" fill="#e8a33d"/></symbol>
<symbol id="i-fillet" viewBox="0 0 64 64"><path d="M6 36c0-14 14-22 30-20 14 2 22 10 20 20-2 10-16 14-30 12-12-2-20-6-20-12z" fill="#d99a4e"/><path d="M20 24l12 22M31 20l12 24M42 20l9 15" stroke="#8a4f1f" stroke-width="3" stroke-linecap="round" fill="none"/></symbol>
<symbol id="i-rice" viewBox="0 0 64 64"><path d="M6 48a26 26 0 0 1 52 0z" fill="#fffaf0" stroke="#d9d2c0" stroke-width="2"/><g fill="#e2dac6"><ellipse cx="24" cy="40" rx="3.5" ry="1.5" transform="rotate(-20 24 40)"/><ellipse cx="34" cy="33" rx="3.5" ry="1.5"/><ellipse cx="43" cy="41" rx="3.5" ry="1.5" transform="rotate(25 43 41)"/><ellipse cx="32" cy="43" rx="3.5" ry="1.5"/></g></symbol>
<symbol id="i-macaroni" viewBox="0 0 64 64"><g fill="none" stroke="#f0c04a" stroke-width="7" stroke-linecap="round"><path d="M10 42q6-18 14 0"/><path d="M28 46q6-20 14 0"/><path d="M42 30q10-10 14 8"/><path d="M12 24q8-9 16 0"/></g></symbol>
<symbol id="i-potato" viewBox="0 0 64 64"><g fill="#f4c542" stroke="#d9a21e" stroke-width="1.5"><rect x="14" y="8" width="8" height="34" rx="3" transform="rotate(-12 18 25)"/><rect x="24" y="6" width="8" height="36" rx="3"/><rect x="34" y="8" width="8" height="34" rx="3" transform="rotate(10 38 25)"/><rect x="43" y="12" width="8" height="30" rx="3" transform="rotate(18 47 27)"/></g><path d="M12 38h40l-4 20H16z" fill="#d93a2b"/></symbol>
<symbol id="i-egg" viewBox="0 0 64 64"><ellipse cx="22" cy="34" rx="15" ry="19" fill="#fff" stroke="#ddd" stroke-width="2"/><circle cx="22" cy="38" r="7.5" fill="#f6b73c"/><ellipse cx="44" cy="38" rx="13" ry="16" fill="#fff" stroke="#ddd" stroke-width="2"/><circle cx="44" cy="41" r="6.5" fill="#f6b73c"/></symbol>
<symbol id="i-corn" viewBox="0 0 64 64"><ellipse cx="34" cy="30" rx="14" ry="25" fill="#f6c933" transform="rotate(20 34 30)"/><g fill="#e0a800"><circle cx="30" cy="16" r="2"/><circle cx="37" cy="22" r="2"/><circle cx="29" cy="28" r="2"/><circle cx="36" cy="34" r="2"/><circle cx="28" cy="40" r="2"/></g><path d="M8 58q2-24 20-32-6 20-20 32z" fill="#5fb04a"/></symbol>
<symbol id="i-side" viewBox="0 0 64 64"><path d="M6 38h52a26 20 0 0 1-52 0z" fill="#e9eef2" stroke="#c9d3da" stroke-width="2"/><circle cx="20" cy="32" r="9" fill="#5fb04a"/><circle cx="36" cy="29" r="10" fill="#7bc65f"/><circle cx="48" cy="34" r="7" fill="#5fb04a"/><circle cx="29" cy="25" r="6" fill="#e0402f"/><circle cx="44" cy="25" r="5" fill="#bfe08a" stroke="#6aa84f"/></symbol></svg>
<dialog id="m"><button class="x" aria-label="بستن">×</button><div id="mi"></div><h3 id="mt"></h3><p class="note" id="md" style="margin:0"></p><div class="pr" id="mp" style="text-align:center;margin-top:6px"></div><p class="note">تصویر نمایشی است.</p></dialog>
<script>
(function(){
var S=function(i){return [i,70,32,100]};
var C={
'بشقاب ۱':[['burger',44,22,74],['fillet',116,26,66],['rice',66,86,66],['side',134,86,58]],
'بشقاب ۲':[['fillet',40,28,66],['fillet',100,18,62],['macaroni',140,52,62],['potato',62,90,56],['side',124,94,54]],
'بشقاب ۳':[['fillet',40,26,66],['fillet',100,20,64],['potato',60,88,56],['egg',116,90,60],['side',156,52,46]],
'برگر گوشت':[S('burger')],'برگر فیله':[S('burger')],'فیله':[S('fillet')],'ماکارونی':[S('macaroni')],'برنج':[S('rice')],
'سیب\u200cزمینی':[S('potato')],'دورچین':[S('side')],'ذرت':[S('corn')],'تخم\u200cمرغ':[S('egg')]};
function pic(k){return '<svg viewBox="0 0 240 164"><circle cx="120" cy="82" r="76" fill="#fff" stroke="#d8d2c4" stroke-width="4"/>'+C[k].map(function(a){return '<use href="#i-'+a[0]+'" x="'+a[1]+'" y="'+a[2]+'" width="'+a[3]+'" height="'+a[3]+'"/>'}).join('')+'</svg>'}
var d=document.getElementById('m');
d.querySelector('.x').onclick=function(){d.close()};
d.addEventListener('click',function(e){if(e.target===d)d.close()});
document.querySelectorAll('.card,.row').forEach(function(el){
 var t=el.querySelector('h3')||el.querySelector('span');var title=t.textContent.trim(),k=null;
 for(var key in C){if(title.indexOf(key)===0){k=key;break}}
 if(!k)return;
 var th=document.createElement('div');th.className='th';th.innerHTML=pic(k);el.prepend(th);el.classList.add('tap');
 el.onclick=function(){
  var p=el.querySelector('p'),pr=el.querySelector('.pr')||el.querySelector('span:last-child');
  document.getElementById('mi').innerHTML=pic(k);document.getElementById('mt').textContent=title;
  document.getElementById('md').textContent=p?p.textContent:'';document.getElementById('mp').textContent=pr.textContent.replace(/\s*تومان/,' تومان').replace(/\s+/g,' ').trim();
  d.showModal()};
});
var n=document.createElement('p');n.className='note';n.textContent='برای دیدن تصویر و محتویات، روی هر آیتم بزنید.';
document.querySelector('main h2').after(n);
})();
</script>
</body></html>